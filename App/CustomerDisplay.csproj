<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
 <PlatformTarget>x64</PlatformTarget>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Явно задаём XAML items: на Windows/.NET 10 publish из сетевого Z: иногда
         передаёт WPF-компилятору литерал **/*.xaml и падает BG1002/BG1003. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <!-- Версия установленной сборки — с ней авто-апдейтер сравнивает релиз из админки.
         Бампать при каждом релизе (или задавать через -p:Version=x.y.z при publish). -->
    <Version>1.0.65</Version>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="RecommendationWindow.xaml" />
    <Page Include="CdpForm.xaml" />
    <Page Include="TaskKioskWindow.xaml" />
    <Page Include="Assets\Fluent\Icons.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.9.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <!-- Offline-outbox сверки чеков (источник №1): локальная SQLite-очередь исходящих. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Fluent\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fluent\SOURCE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Models/ лежит рядом с App/ (вне директории проекта), поэтому SDK-glob по умолчанию
    (App/**/*.cs) его НЕ подхватывает. Включаем явно — компилируются ReceiptItem.cs
    и POSM-DTO (Models/Posm/*.cs). System.Net.Http.Json / System.Text.Json — в SDK net10.
  -->
  <ItemGroup>
    <Compile Include="..\Models\**\*.cs" />
  </ItemGroup>

</Project>
