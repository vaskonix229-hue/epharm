diff --git a/src/portalPaths.js b/src/portalPaths.js
new file mode 100644
index 0000000..dd4008f
--- /dev/null
+++ b/src/portalPaths.js
@@ -0,0 +1,27 @@
+const MERCH_MOUNT = "/merch";
+const publicMediaPath = /^\/api\/(?:placement-files|task-files|request-item-files)\//;
+const publicStaticMediaPath = /^\/pharmacy-shelf\.png$/;
+
+export function mountPrefixForPath(pathname) {
+  return pathname === MERCH_MOUNT || pathname.startsWith(`${MERCH_MOUNT}/`)
+    ? MERCH_MOUNT
+    : "";
+}
+
+export function appPathForPath(pathname) {
+  return pathname.slice(mountPrefixForPath(pathname).length) || "/";
+}
+
+export function staffPathForPath(pathname) {
+  return `${mountPrefixForPath(pathname)}/staff`;
+}
+
+export function apiBaseForPath(pathname, configuredBase = "") {
+  return (mountPrefixForPath(pathname) || configuredBase || "").replace(/\/$/, "");
+}
+
+export function publicMediaUrlForPath(url, pathname) {
+  return typeof url === "string" && (publicMediaPath.test(url) || publicStaticMediaPath.test(url))
+    ? `${mountPrefixForPath(pathname)}${url}`
+    : url;
+}
diff --git a/src/catalogCities.js b/src/catalogCities.js
new file mode 100644
index 0000000..f6f1d2c
--- /dev/null
+++ b/src/catalogCities.js
@@ -0,0 +1,9 @@
+// Recovered from the currently served, pre-existing production bundle.
+const UNKNOWN_CITY_VALUES = new Set(["", "—", "-", "ан", "аш", "елик", "ен", "имова", "кунаева", "урова"]);
+
+export function catalogCity(value) {
+  const city = String(value || "").trim().replace(/^г[.\s]+/i, "").trim();
+  if (UNKNOWN_CITY_VALUES.has(city.toLocaleLowerCase("ru"))) return "Город требует уточнения";
+  if (/^(усть[\s-]*каменогорск|өскемен|оскемен)$/i.test(city)) return "Усть-Каменогорск";
+  return city;
+}
diff --git a/scripts/test_public_merch_mount.mjs b/scripts/test_public_merch_mount.mjs
new file mode 100644
index 0000000..4871076
--- /dev/null
+++ b/scripts/test_public_merch_mount.mjs
@@ -0,0 +1,39 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  apiBaseForPath,
+  appPathForPath,
+  mountPrefixForPath,
+  publicMediaUrlForPath,
+  staffPathForPath,
+} from "../src/portalPaths.js";
+
+test("direct dev URL keeps root paths", () => {
+  assert.equal(mountPrefixForPath("/staff"), "");
+  assert.equal(appPathForPath("/staff"), "/staff");
+  assert.equal(staffPathForPath("/staff"), "/staff");
+  assert.equal(apiBaseForPath("/staff"), "");
+  assert.equal(publicMediaUrlForPath("/api/task-files/example.jpg", "/staff"), "/api/task-files/example.jpg");
+});
+
+test("ePharm QR URL uses the merch mount for API and media", () => {
+  assert.equal(mountPrefixForPath("/merch/staff"), "/merch");
+  assert.equal(appPathForPath("/merch/staff"), "/staff");
+  assert.equal(staffPathForPath("/merch/staff"), "/merch/staff");
+  assert.equal(apiBaseForPath("/merch/staff"), "/merch");
+  assert.equal(apiBaseForPath("/merch/staff", "https://api.example.test/"), "/merch");
+  assert.equal(publicMediaUrlForPath("/pharmacy-shelf.png", "/merch/staff"), "/merch/pharmacy-shelf.png");
+  for (const kind of ["placement-files", "task-files", "request-item-files"]) {
+    assert.equal(
+      publicMediaUrlForPath(`/api/${kind}/example.jpg`, "/merch/staff"),
+      `/merch/api/${kind}/example.jpg`,
+    );
+  }
+});
+
+test("mount matching is exact and does not rewrite external URLs", () => {
+  assert.equal(mountPrefixForPath("/merchandising/staff"), "");
+  assert.equal(publicMediaUrlForPath("https://cdn.example.test/image.jpg", "/merch/staff"), "https://cdn.example.test/image.jpg");
+  assert.equal(publicMediaUrlForPath("/api/private/secret", "/merch/staff"), "/api/private/secret");
+  assert.equal(apiBaseForPath("/staff", "https://api.example.test/"), "https://api.example.test");
+});
diff --git a/scripts/test_public_merch_build.mjs b/scripts/test_public_merch_build.mjs
new file mode 100644
index 0000000..5a2b71d
--- /dev/null
+++ b/scripts/test_public_merch_build.mjs
@@ -0,0 +1,18 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const indexPath = fileURLToPath(new URL("../dist/index.html", import.meta.url));
+
+test("one production build loads assets at both /staff and /merch/staff", () => {
+  const html = readFileSync(indexPath, "utf8");
+  assert.match(html, /src="\.\/assets\//);
+  assert.match(html, /href="\.\/assets\//);
+  assert.doesNotMatch(html, /(?:src|href)="\/assets\//);
+
+  for (const pathname of ["/staff", "/merch/staff"]) {
+    const assetBase = new URL("./assets/", `https://example.test${pathname}`).pathname;
+    assert.equal(assetBase, pathname === "/staff" ? "/assets/" : "/merch/assets/");
+  }
+});
diff --git a/scripts/test_catalog_cities_recovery.mjs b/scripts/test_catalog_cities_recovery.mjs
new file mode 100644
index 0000000..a72454f
--- /dev/null
+++ b/scripts/test_catalog_cities_recovery.mjs
@@ -0,0 +1,18 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { catalogCity } from "../src/catalogCities.js";
+
+test("recovered catalog city normalizes the production bundle's known aliases", () => {
+  assert.equal(catalogCity("г. Алматы"), "Алматы");
+  assert.equal(catalogCity("г Усть-Каменогорск"), "Усть-Каменогорск");
+  assert.equal(catalogCity("Өскемен"), "Усть-Каменогорск");
+  assert.equal(catalogCity("оскемен"), "Усть-Каменогорск");
+  assert.equal(catalogCity("г. Астана"), "Астана");
+});
+
+test("recovered catalog city preserves the exact bundle's unknown-value set", () => {
+  for (const unknown of ["", "—", "-", "ан", "аш", "елик", "ен", "имова", "кунаева", "урова"]) {
+    assert.equal(catalogCity(unknown), "Город требует уточнения", unknown);
+  }
+  assert.equal(catalogCity(null), "Город требует уточнения");
+});
